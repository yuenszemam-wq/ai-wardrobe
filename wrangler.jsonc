{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-wardrobe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // 每分鐘處理 D1 暫存匯入（import_staging → R2）
  "triggers": { "crons": ["* * * * *"] },

  // 前端 (Vite build) 由 Static Assets 提供；/api 及 /mcp 先交給 Worker 處理
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp/*"]
  },

  // 只存衣物資料 —— 與 kitchen-stock-db 完全獨立
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-wardrobe-db",
      "database_id": "cc7d7df4-25bc-4452-a011-3e21d50c0e48",
      "migrations_dir": "migrations"
    }
  ],

  // 私人 bucket：原圖、去背圖、縮圖、穿搭圖
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "ai-wardrobe-images" }
  ],

  // AI Lab Phase 1：Workers AI（只在 AI_LAB_ENABLED=true 且設定頁開啟時才會呼叫；預設關閉）
  "ai": { "binding": "AI" },

  // 非機密設定（機密資料一律存 D1 雜湊，不放這裡）。
  // R2 用量頁的官方數據需要 Worker Secret CF_API_TOKEN（Account Analytics: Read；不放在 repo）。CF_ACCOUNT_ID 不是機密，放在 vars。
  "vars": {
    "AW_ENV": "production",
    "CF_ACCOUNT_ID": "978af1b48255f53f5bad01111775f5e8",
    "MAX_UPLOAD_MB": "25",
    "TOKEN_DAILY_CALL_LIMIT": "3000",
    "TOKEN_DAILY_UPLOAD_MB": "800",
    "UPLOAD_LINK_MAX_MINUTES": "1440",
    // AI Lab：預設關閉；配額為第一輪保守測試值（伺服器上限，設定頁只可再調低）
    "AI_LAB_ENABLED": "false",
    "AI_PROVIDER": "workers-ai",
    "AI_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "AI_DAILY_REQUEST_LIMIT": "50",
    "AI_MONTHLY_REQUEST_LIMIT": "500",
    "AI_MAX_BATCH_SIZE": "10",
    "AI_MAX_CONCURRENCY": "1",
    "AI_DAILY_NEURON_BUDGET": "5000",
    "AI_PAID_USAGE_ENABLED": "false"
  },

  // Preview 使用獨立測試資源，不接觸正式衣櫃資料或 Cron。
  "previews": {
    "vars": {
      "AW_ENV": "preview",
      "CF_ACCOUNT_ID": "978af1b48255f53f5bad01111775f5e8",
      "MAX_UPLOAD_MB": "25",
      "TOKEN_DAILY_CALL_LIMIT": "3000",
      "TOKEN_DAILY_UPLOAD_MB": "800",
      "UPLOAD_LINK_MAX_MINUTES": "1440",
      // Preview 可獨立開啟 AI Lab（目前仍為關閉，等擁有者確認 Meta 授權後才改為 "true"）
      "AI_LAB_ENABLED": "false",
      "AI_PROVIDER": "workers-ai",
      "AI_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
      "AI_DAILY_REQUEST_LIMIT": "50",
      "AI_MONTHLY_REQUEST_LIMIT": "500",
      "AI_MAX_BATCH_SIZE": "10",
      "AI_MAX_CONCURRENCY": "1",
      "AI_DAILY_NEURON_BUDGET": "5000",
      "AI_PAID_USAGE_ENABLED": "false"
    },
    "ai": { "binding": "AI" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ai-wardrobe-preview-db",
        "database_id": "27d5c623-adb0-412e-a89f-7b577dace7ef",
        "migrations_dir": "migrations"
      }
    ],
    "r2_buckets": [
      { "binding": "IMAGES", "bucket_name": "ai-wardrobe-preview-images" }
    ]
  }
}
