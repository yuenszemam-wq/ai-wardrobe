{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-wardrobe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },

  // 每分鐘處理 D1 暫存匯入（import_staging → R2）
  "triggers": { "crons": ["* * * * *"] },

  // 前端 (Vite build) 由 Static Assets 提供；/api 及 /mcp 先交給 Worker 處理
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp/*"]
  },

  // 只存衣物資料 —— 與 kitchen-stock-db 完全獨立
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-wardrobe-db",
      "database_id": "cc7d7df4-25bc-4452-a011-3e21d50c0e48",
      "migrations_dir": "migrations"
    }
  ],

  // 私人 bucket：原圖、去背圖、縮圖、穿搭圖
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "ai-wardrobe-images" }
  ],

  // 非機密設定（機密資料一律存 D1 雜湊，不放這裡）
  "vars": {
    "MAX_UPLOAD_MB": "25",
    "TOKEN_DAILY_CALL_LIMIT": "3000",
    "TOKEN_DAILY_UPLOAD_MB": "800",
    "UPLOAD_LINK_MAX_MINUTES": "1440"
  }
}
